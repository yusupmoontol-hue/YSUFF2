local AutoBrainrotEnabled = false
local AutoTeleportEnabled = false
local isMinimized = false

task.spawn(function()
    while true do
        if AutoBrainrotEnabled then
            pcall(function()
                local ReplicatedStorage = game:GetService("ReplicatedStorage")
                local packages = ReplicatedStorage:FindFirstChild("Shared") and ReplicatedStorage.Shared:FindFirstChild("Packages")
                local network = packages and packages:FindFirstChild("Network")
                
                if network then
                    local kickEvent = network:FindFirstChild("rev_KickEvent")
                    local transformed = network:FindFirstChild("rev_Transformed")
                    local kickCollect = network:FindFirstChild("rev_KickCollect")
                    
                    if kickEvent then kickEvent:FireServer(1) end
                    if transformed then transformed:FireServer() end
                    if kickCollect then kickCollect:FireServer() end
                end
            end)
            
            local customDelay = tonumber(DelayInput.Text) or 0.01
            if customDelay > 0 then
                task.wait(customDelay)
            else
                task.run(task.wait)
            end
        else
            task.wait(0.2)
        end
    end
end)

task.spawn(function()
    while true do
        if AutoTeleportEnabled then
            pcall(function()
                local player = game:GetService("Players").LocalPlayer
                local character = player.Character
                
                if character and character:FindFirstChild("HumanoidRootPart") then
                    character.HumanoidRootPart.CFrame = CFrame.new(702, 3, 233)
                end
            end)
            task.wait(0.5)
        else
            task.wait(0.3)
        end
    end
end)

ToggleButton.MouseButton1Click:Connect(function()
