        StatusLabel.Text = "Status: ON 🟢"
        StatusLabel.TextColor3 = Color3.fromRGB(90, 255, 90)
    else
        ToggleButton.Text = "START AUTO BRAINROT"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        StatusLabel.Text = "Status: OFF 🔴"
